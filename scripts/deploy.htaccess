Options -Indexes
ServerSignature Off

# The Vite build also leaves an index.html here; the home page must come from CodeIgniter.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # One address per page: www and trailing-slash variants redirect to the canonical URL.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Protect application, dependency and runtime directories in shared hosting.
    RewriteRule ^(?:app|vendor|writable)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env|env|composer\.(?:json|lock)|spark|preload\.php|LICENSE)$ - [F,L,NC]

    # Everything in build/ has a content hash in its name; mark it for the long cache lifetime set below.
    RewriteRule ^build/ - [E=IMMUTABLE:1]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

<FilesMatch "^(\.env|env|composer\.(json|lock)|spark|preload\.php|LICENSE)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
    # A rebuilt file gets a new name, so the old one can be kept for a year without ever going stale.
    Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE
    # The icon and logo keep their name, so they are kept for a month. Matching them by name keeps this rule off build/.
    <FilesMatch "^webskode-(icon\.svg|logo\.png)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/json application/javascript text/javascript image/svg+xml
</IfModule>
