Options -Indexes
ServerSignature Off

# The Vite build also leaves an index.html here; the home page must come from CodeIgniter.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # One address per page: www and trailing-slash variants redirect to the canonical URL.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Protect application, dependency and runtime directories in shared hosting.
    RewriteRule ^(?:app|vendor|writable)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env|env|composer\.(?:json|lock)|spark|preload\.php|LICENSE)$ - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

<FilesMatch "^(\.env|env|composer\.(json|lock)|spark|preload\.php|LICENSE)$">
    Require all denied
</FilesMatch>
